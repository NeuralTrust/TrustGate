# Application Environment
APP_ENV=dev

# Server Configuration (HTTP listeners)
SERVER_ADMIN_PORT=8080
SERVER_PROXY_PORT=8081
SERVER_READ_TIMEOUT=60s
# Applies to the whole response write. Keep it above the 5m stream bound, or
# long SSE streams are truncated mid-flight.
SERVER_WRITE_TIMEOUT=300s
SERVER_IDLE_TIMEOUT=120s

# Server Secret (REQUIRED, at least 32 bytes of random data)
# Signs and verifies admin-plane and playground JWTs, and derives the AES-256-GCM
# key used to encrypt provider credentials in registries (registries.auth) and
# vault credentials at rest. The process fails to boot if this is shorter than 32
# bytes. Generate one with: openssl rand -base64 32
SERVER_SECRET_KEY=

# Admin machine-to-machine credentials (optional)
# Long-running automation authenticates with short-lived JWTs minted by the
# NeuralTrust control plane and signed with an RSA key that never reaches
# TrustGate. Each token is bound to one gateway and a scope list, so leaving
# these unset simply disables service tokens; console JWTs are unaffected.
# ADMIN_M2M_ISSUER: `iss` the control plane stamps, e.g. https://app.neuraltrust.ai
# ADMIN_M2M_AUDIENCE: expected `aud` (default trustgate-admin)
# ADMIN_M2M_PUBLIC_KEYS: the verification key as base64-encoded PEM, which keeps
#   the whole value on a single line:
#     openssl rsa -in m2m.key -pubout | base64
#   To rotate, pass a JSON array instead and keep both entries live while the
#   issuer switches; tokens then carry the kid that selects the key:
#     [{"kid":"2026-08","pem":"LS0tLS1CRUdJTiBQVUJMSUMgS0VZ..."}, {...}]
# ADMIN_M2M_MAX_TOKEN_TTL: ceiling on a token's own exp-iat span (default 24h).
#   Verification is offline, so this is also how long a revoked credential's last
#   token keeps working; lower it if you need revocation to bite sooner.
ADMIN_M2M_ISSUER=
ADMIN_M2M_AUDIENCE=trustgate-admin
ADMIN_M2M_PUBLIC_KEYS=
ADMIN_M2M_MAX_TOKEN_TTL=24h

# Require an explicit platform_admin claim for cross-tenant console tokens.
# Enable once every issuer stamps the claim; until then a console token without
# tenant_id keeps its legacy platform-admin meaning.
ADMIN_PLATFORM_CLAIM_REQUIRED=false

# Gateway Discovery
# The X-AG-Gateway-Slug header identifies the gateway; when absent it falls back to the {slug}.<base-domain> host.
# GATEWAY_BASE_DOMAIN: suffix to resolve {slug}.<base-domain> proxy hosts (gw.neuraltrust.sandbox for local dev, see make local-dns)
# MCP_BASE_DOMAIN: suffix to resolve {slug}.<base-domain> MCP hosts returned in the gateway response
GATEWAY_BASE_DOMAIN=gw.neuraltrust.sandbox
MCP_BASE_DOMAIN=mcp.neuraltrust.sandbox

# Fixed origin for upstream MCP connect OAuth redirect_uri (authorize + code
# exchange + DCR). Empty = use the request Host (per-gateway {slug}.mcp.*).
# Set in multi-tenant cloud so one Google/Entra app can allowlist a single host:
#   redirect_uri = {MCP_OAUTH_PUBLIC_BASE_URL}/oauth/callback/{provider}
# Host must already route to the MCP plane (e.g. gateway-mcp.* HTTPRoute).
# MCP_OAUTH_PUBLIC_BASE_URL=https://gateway-mcp.dev.neuraltrust.ai

# Built-in NeuralTrust default identity provider (MCP)
# When MCP_DEFAULT_IDP_ISSUER is set, MCP consumers that have no oauth2 identity
# provider of their own fall back to the NeuralTrust platform as their OAuth2
# authorization server, so a PoC works without the operator standing up and
# registering an IdP. Leave MCP_DEFAULT_IDP_ISSUER empty to disable (behaviour
# unchanged). The gateway brokers the interactive login and mints its own MCP
# session token bound to the platform user.
#   MCP_DEFAULT_IDP_ISSUER: the platform authorization-server issuer URL.
#     authorize/token/jwks default to {ISSUER}/authorize, /token and /jwks.
#   MCP_DEFAULT_IDP_CLIENT_ID / _CLIENT_SECRET: TrustGate's pre-registered
#     client at the platform authorization server.
#   MCP_DEFAULT_IDP_AUDIENCE: expected access-token audience (default neuraltrust-mcp).
# MCP_DEFAULT_IDP_ISSUER=https://app.neuraltrust.ai/api/mcp/oauth
# MCP_DEFAULT_IDP_CLIENT_ID=trustgate
# MCP_DEFAULT_IDP_CLIENT_SECRET=
# MCP_DEFAULT_IDP_AUDIENCE=neuraltrust-mcp
# MCP_DEFAULT_IDP_AUTHORIZE_URL=
# MCP_DEFAULT_IDP_TOKEN_URL=
# MCP_DEFAULT_IDP_JWKS_URL=
# MCP_DEFAULT_IDP_SCOPES=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE_ENABLED=true   # optional local file sink at var/log.log (off in k8s)

# Database Configuration (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=agentgateway
DB_PASSWORD=postgres
DB_NAME=agentgateway
DB_SSL_MODE=disable
DB_SSL_ROOT_CERT=
# Postgres authentication mode: default (static DB_PASSWORD) | aws (RDS/Aurora IAM
# auth via IRSA). With aws the password is ignored and a short-lived IAM token is
# generated per connection; AWS_REGION and a native RDS endpoint are required and
# DB_SSL_MODE must be require|verify-ca|verify-full.
POSTGRES_LOGIN=default

# Database Connection Pool Configuration (pgxpool)
DB_MIN_CONNS=1
DB_MAX_CONNS=10
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional Redis 6+ ACL username (e.g. AWS ElastiCache user group). Empty = default user.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=3
REDIS_TLS_ENABLED=false
REDIS_TLS_INSECURE_VERIFY=false
# Redis authentication mode: default (static REDIS_PASSWORD) | aws (ElastiCache IAM
# auth via IRSA). With aws the password is ignored and a short-lived SigV4 token is
# generated per connection; REDIS_TLS_ENABLED must be true, AWS_REGION comes from the
# default credential chain, and REDIS_USERNAME (the IAM-enabled RBAC user) and
# REDIS_CACHE_NAME are required.
REDIS_LOGIN=default
# ElastiCache replication-group id or serverless cache name used as the SigV4 signing
# host; required when REDIS_LOGIN=aws.
REDIS_CACHE_NAME=
# Set to true when REDIS_CACHE_NAME is an ElastiCache Serverless cache (adds the
# ResourceType=ServerlessCache token parameter); leave false for replication groups.
REDIS_AWS_SERVERLESS=false

MCP_CONNECT_RATE_LIMIT_ENABLED=true
MCP_CONNECT_RATE_LIMIT_SOURCE=10
MCP_CONNECT_RATE_LIMIT_CONSUMER=100
MCP_CONNECT_RATE_LIMIT_WINDOW=1m
MCP_CONNECT_TRUSTED_PROXY_CIDRS=

# In-process TTL cache (app-layer finders).
# RUN-291 will add a parallel Redis-backed layer; same env var stays.
CACHE_LOCAL_TTL=5m

# Telemetry Configuration
TELEMETRY_ENABLED=true
# Low-cardinality service metrics; independent from product request events.
OPS_METRICS_ENABLED=false

# Path to the declarative default-exporters file (loaded at boot, fail-fast on
# invalid entries; a missing/empty file falls back to TELEMETRY_EXPORTERS_METADATA
# and TELEMETRY_EXPORTERS_RAW, otherwise starts with no default exporters).
# See config/telemetry.example.yaml.
TELEMETRY_EXPORTERS_FILE=config/telemetry.yaml
# YAML/JSON lists, or a type token (otlp, postgres; comma-separated). Used when
# the exporters file is absent. otel is accepted as an alias of otlp.
# TELEMETRY_EXPORTERS_METADATA=otlp
# TELEMETRY_EXPORTERS_RAW=postgres
TELEMETRY_EXPORTERS_METADATA=
TELEMETRY_EXPORTERS_RAW=

# OTLP exporter defaults (opt-in per gateway via telemetry.exporters; per-gateway
# settings override these). Timeout is milliseconds per the OTel spec (e.g. 10000);
# a Go duration string (e.g. 10s) is also accepted.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=
OTEL_EXPORTER_OTLP_INSECURE=
OTEL_EXPORTER_OTLP_COMPRESSION=

# Metrics Configuration
METRICS_ENABLED=true
METRICS_QUEUE_SIZE=1000
METRICS_WORKER_COUNT=1
METRICS_FLUSH_INTERVAL=5s

# Playground Trace Store Configuration
# Stores the metrics Event of playground requests (those carrying
# X-AG-Playground-Token) in Redis so the dashboard can fetch the trace by its
# X-Request-Id. Enabled by default; disable to turn the integration off.
PLAYGROUND_TRACE_STORE_ENABLED=true
PLAYGROUND_TRACE_STORE_TTL=10m
# Hybrid data planes: push each playground trace to the control-plane store
# (PUT {URL}/v1/playground/traces/{trace_id}) so the dashboard's playground
# info panel keeps working when the request ran on a customer data plane. Only
# playground-tagged requests are pushed, never regular traffic. TOKEN is sent
# as a bearer and validated by the control-plane admin auth. Empty disables
# the push (SaaS and single-plane deployments).
# PLAYGROUND_TRACE_PUSH_URL=
# PLAYGROUND_TRACE_PUSH_TOKEN=

# Upstream Forwarding Configuration
UPSTREAM_TIMEOUT=300s
UPSTREAM_ERROR_PASSTHROUGH=true

# Provider Defaults
PROVIDER_REQUEST_TIMEOUT=300s
# Bounds the wait for upstream response headers. Non-streaming providers hold
# headers back until the completion is fully generated, so this caps total
# generation time rather than time-to-first-byte. Defaults to
# PROVIDER_REQUEST_TIMEOUT; setting it lower silently truncates long
# completions. Only set it explicitly to fail faster on unresponsive providers.
# PROVIDER_RESPONSE_HEADER_TIMEOUT=300s
PROVIDER_MAX_RETRIES=2

# Model/Provider Catalog (admin-only, best-effort sync from models.dev on boot)
# Public, key-less source of provider-native model IDs and pricing.
# Override only to point at a mirror; leave empty for https://models.dev
MODELS_DEV_BASE_URL=

# TrustGuard Guardrail Configuration
# Base URL of the external TrustGuard service used by the trustguard plugin.
# Leave empty to keep the plugin inert (pass-through) even if a policy references
# it. Per-policy base_url settings override this value.
TRUSTGUARD_BASE_URL=
TRUSTGUARD_TIMEOUT=15s
# Client-credentials used to obtain a short-lived bearer token from TrustGuard's
# /v1/token endpoint (one credential per gateway deploy). The plugin refuses to
# be configured on a policy unless both are set. For a multi-tenant TrustGate
# deploy use the platform credential; for a per-team deploy use that team's
# credential. The token endpoint is derived from TRUSTGUARD_BASE_URL.
TRUSTGUARD_CLIENT_ID=
TRUSTGUARD_CLIENT_SECRET=

# OpenAI Moderation Guardrail Configuration
# Base URL of the OpenAI Moderations API used by the openai_moderation plugin.
# api_key is configured per-policy in plugin settings, not here.
OPENAI_MODERATION_BASE_URL=https://api.openai.com
OPENAI_MODERATION_TIMEOUT=15s

# Plan rate limit per gateway (burst + monthly quota). On by default;
# set to false to disable.
RATE_LIMIT_ENABLED=true

# PROXY_SERVE_HYBRID_GATEWAYS controls whether this proxy/mcp deployment serves
# gateways stamped entitlements.data_plane=hybrid (gateways whose traffic belongs
# on a customer-run data plane). Defaults to CONFIG_SYNC_DATA_PLANE_ENABLED, so
# hosted (SaaS) deployments refuse them with 421 and DB-less customer data planes
# serve them. Set true explicitly only on a customer data plane that runs against
# its own Postgres instead of config-sync.
# PROXY_SERVE_HYBRID_GATEWAYS=false

# Config Sync (ENG-959): gRPC-based snapshot distribution between the admin control
# plane and the DB-less proxy/mcp data planes. The data plane dials the control plane
# (egress-only) over a bidirectional gRPC stream for change notices/acks and pulls the
# compiled snapshot in chunks via GetSnapshot.
# CONFIG_SYNC_DATA_PLANE_ENABLED is the DB-less master flag; leave false to keep the
# proxy/mcp planes on Postgres. When true, DB_* are not required but the CONFIG_SYNC_*
# set below is: token, well-formed CONFIG_SYNC_GRPC_ENDPOINT (host:port), LKG path, a
# base64 key that decodes to exactly 32 bytes (AES-256), and a positive poll interval.
# REDIS_HOST stays required on the data plane. Generate the key with:
# openssl rand -base64 32
CONFIG_SYNC_DATA_PLANE_ENABLED=false
CONFIG_SYNC_TOKEN=
# CONFIG_SYNC_TOKEN_PREVIOUS is the prior bearer accepted alongside CONFIG_SYNC_TOKEN
# during a rotation, so data planes keep authenticating while the new token rolls out.
CONFIG_SYNC_TOKEN_PREVIOUS=
# Control-plane gRPC endpoint (host:port) the data plane dials. Required (well-formed
# host:port) when the flag is ON.
CONFIG_SYNC_GRPC_ENDPOINT=
# Control-plane gRPC listen address (CP). Defaults to :8083.
CONFIG_SYNC_GRPC_LISTEN_ADDR=:8083
# Data-plane dial TLS: optional custom CA bundle path (defaults to the system roots when empty).
CONFIG_SYNC_TLS_CA=
# Data-plane dial TLS: optional SNI/server-name override when it differs from the endpoint host.
CONFIG_SYNC_TLS_SERVER_NAME=
# Data-plane dial TLS: dev-only plaintext dial. Rejected at boot in deployed environments.
CONFIG_SYNC_TLS_INSECURE=false
# Control-plane gRPC server TLS cert/key (PEM paths). Required together on the CP in deployed environments.
CONFIG_SYNC_GRPC_TLS_CERT=
CONFIG_SYNC_GRPC_TLS_KEY=
# Data-plane keepalive tuning that keeps the long-lived Sync stream (and any intermediary NAT/LB) alive.
CONFIG_SYNC_GRPC_KEEPALIVE_TIME=30s
CONFIG_SYNC_GRPC_KEEPALIVE_TIMEOUT=10s
# Data-plane reconnect/watch backoff bounds for the gRPC transport.
CONFIG_SYNC_GRPC_MIN_BACKOFF=1s
CONFIG_SYNC_GRPC_MAX_BACKOFF=30s
CONFIG_SYNC_LKG_PATH=/var/lib/trustgate/snapshot.lkg
CONFIG_SYNC_LKG_KEY=
CONFIG_SYNC_POLL_INTERVAL=5m
CONFIG_SYNC_RECOMPILE_DEBOUNCE=2s
# CONFIG_SYNC_RECOMPILE_BACKSTOP recompiles periodically even without a write
# signal, so the control plane recovers from a failed boot compile and picks up
# out-of-band mutations.
CONFIG_SYNC_RECOMPILE_BACKSTOP=5m
# Control-plane change-marker outbox bounds (safety cap on the pending backlog).
CONFIG_SYNC_OUTBOX_RETENTION=24h
CONFIG_SYNC_OUTBOX_MAX_ROWS=10000
CONFIG_SYNC_INSTANCE_ID=

# CORS Configuration (applied to both admin and proxy servers)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-AG-Trace-Id
CORS_EXPOSE_HEADERS=X-AG-Trace-Id
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600
